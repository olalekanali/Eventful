<div class="page-head">
  <h1>All events</h1>
  <p class="muted"><%= total %> total events across the platform.</p>
</div>

<form action="/admin/events" method="GET" class="filter-bar">
  <input type="search" name="search" placeholder="Search title..." value="<%= filters.search %>" class="filter-search" />
  <select name="status" class="filter-select">
    <option value="">Any status</option>
    <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
    <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published</option>
    <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
    <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
  </select>
  <button type="submit" class="btn btn-primary">Filter</button>
</form>

<% if (events.length === 0) { %>
  <div class="empty-state"><p>No events match these filters.</p></div>
<% } else { %>
  <div class="data-table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Creator</th>
          <th>Status</th>
          <th>Date</th>
          <th>Sold</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% events.forEach(function (e) { %>
          <tr>
            <td><strong><%= e.title %></strong></td>
            <td>
              <% if (e.creator) { %>
                <%= e.creator.firstName %> <%= e.creator.lastName %>
                <div class="muted small"><%= e.creator.email %></div>
              <% } %>
            </td>
            <td><span class="status-badge status-<%= e.status %>"><%= e.status %></span></td>
            <td><%= new Date(e.startDate).toLocaleDateString() %></td>
            <td><%= e.ticketsSold %> / <%= e.totalTickets %></td>
            <td class="text-right"><a href="/events/<%= e._id %>" class="text-link small">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <%- include('../../partials/pagination', { page: page, totalPages: totalPages, query: '' }) %>
<% } %>
