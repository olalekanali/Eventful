<div class="page-head">
  <h1>Payment history</h1>
  <p class="muted">All your payments on <%= appName %>.</p>
</div>

<% if (result.items.length === 0) { %>
  <div class="empty-state"><p>No payments yet.</p></div>
<% } else { %>
  <div class="data-table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Event</th>
          <th>Reference</th>
          <th>Amount</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% result.items.forEach(function (p) { %>
          <tr>
            <td><%= new Date(p.createdAt).toLocaleDateString() %></td>
            <td><%= p.metadata && p.metadata.eventTitle ? p.metadata.eventTitle : '—' %></td>
            <td><code><%= p.reference %></code></td>
            <td><%= p.currency %> <%= Number(p.amount).toLocaleString() %></td>
            <td><span class="status-badge status-<%= p.status %>"><%= p.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../../partials/pagination', { page: result.page, totalPages: result.totalPages, query: '' }) %>
<% } %>
