<div class="auth-shell">
  <div class="auth-card">
    <span class="eyebrow">FOR CREATORS</span>
    <h1>Host your event</h1>
    <p class="muted">Create a creator account to list events, sell tickets, and manage attendees.</p>

    <form action="/auth/register" method="POST" class="form">
      <div class="form-row form-row-split">
        <div>
          <label for="firstName">First name</label>
          <input type="text" name="firstName" id="firstName" required autocomplete="given-name" autofocus />
        </div>
        <div>
          <label for="lastName">Last name</label>
          <input type="text" name="lastName" id="lastName" required autocomplete="family-name" />
        </div>
      </div>

      <div class="form-row">
        <label for="email">Email</label>
        <input type="email" name="email" id="email" required autocomplete="email" />
      </div>

      <div class="form-row">
        <label for="phoneNumber">Phone number <span class="muted">(optional)</span></label>
        <input type="tel" name="phoneNumber" id="phoneNumber" autocomplete="tel" />
      </div>

      <div class="form-row">
        <label for="password">Password</label>
        <input type="password" name="password" id="password" required minlength="8" autocomplete="new-password" />
        <small class="muted">Minimum 8 characters.</small>
      </div>

      <button type="submit" class="btn btn-primary btn-block">Create creator account</button>
    </form>

    <p class="auth-foot">
      Already a member? <a href="/auth/login">Sign in</a>
      <br>
      <span class="muted small">Just want to buy tickets? <a href="/events">Browse events</a> — no account needed.</span>
    </p>
  </div>
</div>
