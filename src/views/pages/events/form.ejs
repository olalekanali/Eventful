<div class="page-head">
  <h1><%= event ? 'Edit event' : 'Create a new event' %></h1>
  <p class="muted">Fill in the details below to <%= event ? 'update' : 'launch' %> your event.</p>
</div>

<form action="<%= action %>" method="<%= method %>" enctype="multipart/form-data" class="form form-wide">
  <div class="form-section">
    <h2>Basics</h2>
    <p class="section-desc">Tell eventees what your event is about.</p>

    <div class="form-row">
      <label for="title">Event title</label>
      <input type="text" name="title" id="title" required value="<%= event ? event.title : '' %>" placeholder="e.g. Lagos Summer Concert 2026" />
    </div>

    <div class="form-row">
      <label for="description">Description</label>
      <textarea name="description" id="description" rows="5" required placeholder="What can attendees expect?"><%= event ? event.description : '' %></textarea>
    </div>

    <div class="form-row">
      <label for="category">Category</label>
      <select name="category" id="category" required>
        <% categories.forEach(function (c) { %>
          <option value="<%= c %>" <%= event && event.category === c ? 'selected' : '' %>><%= c.charAt(0).toUpperCase() + c.slice(1) %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div class="form-section">
    <h2>Banner image</h2>
    <p class="section-desc">Upload a banner that captures the vibe of your event. JPG, PNG, WebP or GIF, up to 5 MB.</p>

    <label class="file-upload" for="bannerFile">
      <div class="file-upload-icon">↑</div>
      <div class="file-upload-text">
        <strong id="banner-filename">Click to choose a banner image</strong>
        <small>Recommended: 1600×800 pixels or wider</small>
      </div>
      <input type="file" name="bannerFile" id="bannerFile" accept="image/png,image/jpeg,image/webp,image/gif" />
    </label>

    <% if (event && event.bannerImage) { %>
      <div class="banner-preview">
        <img src="<%= event.bannerImage %>" alt="Current banner" />
      </div>
      <small class="muted">Current banner — upload a new file to replace it.</small>
    <% } %>
  </div>

  <div class="form-section">
    <h2>Date & venue</h2>

    <div class="form-row-split">
      <div class="form-row">
        <label for="startDate">Start date & time</label>
        <input type="datetime-local" name="startDate" id="startDate" required value="<%= event ? new Date(event.startDate).toISOString().slice(0,16) : '' %>" />
      </div>
      <div class="form-row">
        <label for="endDate">End date & time</label>
        <input type="datetime-local" name="endDate" id="endDate" required value="<%= event ? new Date(event.endDate).toISOString().slice(0,16) : '' %>" />
      </div>
    </div>

    <div class="form-row">
      <label for="venue">Venue name</label>
      <input type="text" name="venue" id="venue" required value="<%= event ? event.venue : '' %>" placeholder="e.g. Eko Convention Center" />
    </div>

    <div class="form-row">
      <label for="address">Address</label>
      <input type="text" name="address" id="address" value="<%= event ? event.address || '' : '' %>" placeholder="Street address" />
    </div>

    <div class="form-row-split">
      <div class="form-row">
        <label for="city">City</label>
        <input type="text" name="city" id="city" value="<%= event ? event.city || '' : '' %>" />
      </div>
      <div class="form-row">
        <label for="country">Country</label>
        <input type="text" name="country" id="country" value="<%= event ? event.country || '' : '' %>" />
      </div>
    </div>
  </div>

  <div class="form-section">
    <h2>Tickets & pricing</h2>

    <div class="form-row-triple">
      <div class="form-row">
        <label for="totalTickets">Total tickets</label>
        <input type="number" name="totalTickets" id="totalTickets" required min="1" value="<%= event ? event.totalTickets : '' %>" />
      </div>
      <div class="form-row">
        <label for="ticketPrice">Price <small class="muted">(0 = free)</small></label>
        <input type="number" name="ticketPrice" id="ticketPrice" required min="0" step="0.01" value="<%= event ? event.ticketPrice : '' %>" />
      </div>
      <div class="form-row">
        <label for="currency">Currency</label>
        <input type="text" name="currency" id="currency" value="<%= event ? event.currency : 'NGN' %>" maxlength="3" />
      </div>
    </div>
  </div>

  <div class="form-section">
    <h2>Default reminders</h2>
    <p class="section-desc">Automatically nudge every attendee before your event. They can also set their own.</p>

    <div class="checkbox-group">
      <% reminderTypes.forEach(function (rt) { %>
        <% var checked = event && event.defaultReminders && event.defaultReminders.indexOf(rt) !== -1; %>
        <label class="checkbox-card">
          <input type="checkbox" name="defaultReminders" value="<%= rt %>" <%= checked ? 'checked' : '' %> />
          <span><%= reminderLabels[rt] %></span>
        </label>
      <% }) %>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" name="submitAction" value="publish" class="btn btn-accent btn-lg">
      <%= event ? 'Save & publish' : 'Publish event' %>
    </button>
    <button type="submit" name="submitAction" value="draft" class="btn btn-ghost btn-lg">
      Save as draft
    </button>
    <a href="<%= event ? '/events/' + event._id : '/creator/events' %>" class="btn btn-ghost">Cancel</a>
    <% if (event) { %>
      <form action="/events/<%= event._id %>?_method=DELETE" method="POST" class="inline-form danger-form" onsubmit="return confirm('Delete this event? This cannot be undone.');">
        <button type="submit" class="btn btn-danger">Delete</button>
      </form>
    <% } %>
  </div>
</form>

<script>
  // Show selected filename
  document.getElementById('bannerFile')?.addEventListener('change', function (e) {
    var f = e.target.files && e.target.files[0];
    if (f) document.getElementById('banner-filename').textContent = f.name;
  });
</script>
