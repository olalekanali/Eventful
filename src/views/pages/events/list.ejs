<div class="page-head">
  <h1>Browse events</h1>
  <p class="muted">Find your next unforgettable moment.</p>
</div>

<form action="/events" method="GET" class="filter-bar">
  <input
    type="search"
    name="search"
    placeholder="Search events, venues..."
    value="<%= filters.search %>"
    class="filter-search"
  />
  <select name="category" class="filter-select">
    <option value="">All categories</option>
    <% categories.forEach(function (c) { %>
      <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </select>
  <input
    type="text"
    name="city"
    placeholder="City"
    value="<%= filters.city %>"
    class="filter-city"
  />
  <button type="submit" class="btn btn-primary">Filter</button>
  <% if (filters.search || filters.category || filters.city) { %>
    <a href="/events" class="btn btn-ghost">Clear</a>
  <% } %>
</form>

<% if (result.items.length === 0) { %>
  <div class="empty-state">
    <p>No events match your filters. Try broadening your search.</p>
  </div>
<% } else { %>
  <p class="muted result-count"><%= result.total %> event<%= result.total !== 1 ? 's' : '' %> found</p>

  <div class="event-grid">
    <% result.items.forEach(function (event) { %>
      <%- include('../../partials/event-card', { event: event }) %>
    <% }) %>
  </div>

  <%- include('../../partials/pagination', {
    page: result.page,
    totalPages: result.totalPages,
    query: (filters.search ? 'search=' + encodeURIComponent(filters.search) + '&' : '') +
           (filters.category ? 'category=' + encodeURIComponent(filters.category) + '&' : '') +
           (filters.city ? 'city=' + encodeURIComponent(filters.city) + '&' : '')
  }) %>
<% } %>
