<div class="page-head with-action">
  <div>
    <h1>My events</h1>
    <p class="muted">Manage events you've created.</p>
  </div>
  <a href="/events/new" class="btn btn-primary">+ New event</a>
</div>

<form action="/creator/events" method="GET" class="filter-bar">
  <input type="search" name="search" placeholder="Search title..." value="<%= filters.search %>" class="filter-search" />
  <select name="status" class="filter-select">
    <option value="">Any status</option>
    <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
    <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published</option>
    <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
    <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
  </select>
  <button type="submit" class="btn btn-primary">Filter</button>
</form>

<% if (result.items.length === 0) { %>
  <div class="empty-state">
    <p>You haven't created any events yet.</p>
    <a href="/events/new" class="btn btn-primary">Create your first event</a>
  </div>
<% } else { %>
  <div class="data-table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Status</th>
          <th>Start date</th>
          <th>Sold</th>
          <th>Capacity</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% result.items.forEach(function (e) { %>
          <tr>
            <td><strong><%= e.title %></strong></td>
            <td><span class="status-badge status-<%= e.status %>"><%= e.status %></span></td>
            <td><%= new Date(e.startDate).toLocaleDateString() %></td>
            <td><%= e.ticketsSold %></td>
            <td><%= e.totalTickets %></td>
            <td class="text-right">
              <a href="/events/<%= e._id %>" class="text-link small">View</a>
              <a href="/events/<%= e._id %>/edit" class="text-link small">Edit</a>
              <a href="/events/<%= e._id %>/attendees" class="text-link small">Attendees</a>
              <a href="/creator/events/<%= e._id %>/analytics" class="text-link small">Analytics</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <%- include('../../partials/pagination', { page: result.page, totalPages: result.totalPages, query: '' }) %>
<% } %>
