# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
APP_NAME=Eventful
APP_URL=http://localhost:3000

# ============================================
# MONGODB ATLAS
# ============================================
# Get this from MongoDB Atlas:
#   1. https://cloud.mongodb.com → your cluster → "Connect"
#   2. "Drivers" → Node.js → copy connection string
#   3. Replace <password> with your DB user's password
#   4. Add /eventful before the ? so it picks the database name
#
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/eventful?retryWrites=true&w=majority
MONGODB_URI=

# ============================================
# SESSION & JWT
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string
JWT_SECRET=replace-me-with-a-different-long-random-string
JWT_EXPIRES_IN=7d

# ============================================
# PAYSTACK
# ============================================
# Get from https://dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3000/payments/verify

# ============================================
# MAIL (optional - if blank, emails go to console)
# ============================================
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Eventful <no-reply@eventful.app>"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
